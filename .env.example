# ─────────────────────────────────────────────────────────────────────────────
# Contact form
# ─────────────────────────────────────────────────────────────────────────────
#
# The form posts to the site's own /api/contact route, which sends through
# Resend (https://resend.com). With RESEND_API_KEY and CONTACT_FROM_EMAIL unset,
# the route answers 503 and the form falls back to opening the visitor's mail
# client with the message pre-filled, so the page works before any of this is
# configured.

# Resend API key. Server-side only — do NOT give this a NEXT_PUBLIC_ prefix, or
# it ships to the browser for anyone to read.
RESEND_API_KEY=

# The address the enquiry is sent *from*. It must be at a domain verified in
# Resend. Verify a subdomain rather than the root domain: a domain carries only
# one SPF record, so adding Resend's next to an existing mail provider's on the
# root breaks authentication for both. A subdomain gets its own SPF and DKIM and
# leaves the MX records of the real mailbox untouched.
#   e.g. "OSSM Website <website@send.ossm.org.uk>"
CONTACT_FROM_EMAIL=

# Where enquiries are delivered — an ordinary inbox you already read. Defaults
# to the address published on the site if unset. Replies to an enquiry go to the
# visitor, not to CONTACT_FROM_EMAIL, so this address never needs to be public.
CONTACT_TO_EMAIL=

# The contact address shown in the footer and on the contact page. Optional:
# defaults to info@ossm.org.uk. Whatever is shown here needs a mailbox or a
# forwarding rule behind it, or mail to it will bounce.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: post to a hosted form service (Formspree, Web3Forms, anything that
# accepts a JSON POST) instead of the built-in route. Setting this bypasses
# /api/contact entirely and is the simplest option before a domain exists.
#   e.g. https://formspree.io/f/xxxxxxx
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=

# ─────────────────────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────────────────────
#
# The canonical origin, used for canonical URLs, Open Graph tags, the sitemap
# and robots.txt. No trailing slash. Defaults to https://ossm.org.uk, so this is
# only needed to override it — on a preview deployment, for instance, so its
# canonical tags do not claim to be production.
NEXT_PUBLIC_SITE_URL=
